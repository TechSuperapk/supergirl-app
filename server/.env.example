# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supergirl_journal?retryWrites=true&w=majority

# JWT session tokens issued by THIS backend after verifying a Firebase ID token
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Firebase Admin SDK — used only to verify ID tokens sent by the app after
# Firebase Phone-OTP sign-in. Get this from Firebase Console > Project
# Settings > Service Accounts > Generate new private key.
# Paste the ENTIRE JSON file contents as a single-line string here (the
# escaped \n in private_key is fine — firebaseAdmin.ts un-escapes it).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"super-bae", ...}

# Alternative to the block above: point to a JSON file on disk instead of
# inlining it. If both are set, FIREBASE_SERVICE_ACCOUNT_JSON wins.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── AI Digital Wardrobe (Milestone 2) — server-side ONLY, never in the app ────
# OpenAI GPT-4o Vision: clothing detection + outfit suggestions + OOTD.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional Gemini Vision fallback (not required).
# GEMINI_API_KEY=

# Background removal. Provider is 'removebg' (default) or 'clipdrop'.
REMOVEBG_PROVIDER=removebg
REMOVEBG_API_KEY=
# CLIPDROP_API_KEY=

# Weather (OpenWeather) for the Home weather card, AI suggestions, trip planner.
OPENWEATHER_API_KEY=

# Scheduled "Outfit of the Day" push. Off by default; enable in production.
OOTD_CRON_ENABLED=false
OOTD_CRON_SCHEDULE=0 6 * * *

# ── Razorpay (Club event ticket payments) ─────────────────────────────────────
# key_id is public; key_secret is server-only (creates orders + verifies).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
